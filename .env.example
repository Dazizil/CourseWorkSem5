# Скопируйте в .env и задайте свои значения: cp .env.example .env

POSTGRES_DB=socialnetwork
POSTGRES_USER=socialnetwork
POSTGRES_PASSWORD=socialnetwork

# Минимум 32 символа. Сгенерировать: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-at-least-32-chars

SEED_ADMIN_EMAIL=admin@socialnetwork.local
SEED_ADMIN_PASSWORD=Admin12345!

ASPNETCORE_ENVIRONMENT=Development

FRONTEND_PORT=3000
API_PORT=8080
POSTGRES_PORT=5432
REDIS_PORT=6379
ADMINER_PORT=8081
